{
  "manifest_version": 3,
  "name": "SegmentDesk 媒体检测",
  "version": "0.2.13",
  "key": "",
  "permissions": ["activeTab", "storage", "webRequest", "webNavigation", "clipboardWrite", "nativeMessaging", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png",
    "256": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}
  }
}
